# RFQ intake email (src/app/api/rfq/route.ts)
# Aliyun corporate email (qiye.aliyun.com) SMTP — smtp.qiye.aliyun.com, port 465 (SSL).
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=your-sending-account@yourdomain.com
# Third-party client security password (三方客户端安全密码) generated under
# Settings > 账户与安全 > 账户安全 > 三方客户端登录安全管理 — not your mailbox login password.
SMTP_PASSWORD=
# Comma-separated list of addresses that should receive RFQ notifications.
RFQ_RECIPIENT_EMAILS=sales1@yourdomain.com,sales2@yourdomain.com
