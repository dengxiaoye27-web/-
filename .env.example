# RFQ intake email (src/app/api/rfq/route.ts)
# Aliyun corporate email SMTP — see https://help.aliyun.com/document_detail/36576.html
# for the correct host per your mail plan (e.g. smtp.mxhichina.com).
SMTP_HOST=smtp.mxhichina.com
SMTP_PORT=465
SMTP_USER=your-sending-account@yourdomain.com
# App-specific SMTP authorization code from your mailbox settings — not your login password.
SMTP_PASSWORD=
# Comma-separated list of addresses that should receive RFQ notifications.
RFQ_RECIPIENT_EMAILS=sales1@yourdomain.com,sales2@yourdomain.com
