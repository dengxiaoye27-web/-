.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #10ac84;
  font-weight: 600;
}

.hint-line {
  font-size: 22rpx;
  color: #a4b0be;
  margin-bottom: 16rpx;
}

.radio-group {
  display: flex;
  flex-direction: column;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.custom-inputs {
  margin-top: 12rpx;
  border-top: 1rpx solid #eee;
  padding-top: 12rpx;
}

.input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-row:last-child {
  border-bottom: none;
}

.label {
  color: #576574;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #2c3e50;
}

.info-line {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8395a7;
}

.item-card {
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.item-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.item-label-input {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
}

.remove-btn {
  font-size: 24rpx;
  color: #ee5253;
  margin-left: 16rpx;
}

.item-grid {
  display: flex;
  flex-wrap: wrap;
}

.item-field {
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx 8rpx 8rpx 0;
}

.item-field.wide {
  width: 50%;
}

.mini-label {
  display: block;
  font-size: 20rpx;
  color: #a4b0be;
  margin-bottom: 4rpx;
}

.mini-input {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  font-size: 26rpx;
  color: #2c3e50;
  border: 1rpx solid #e8eaed;
}

.calc-btn {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin: 8rpx 0 24rpx;
}

.error-section {
  color: #ee5253;
  font-size: 26rpx;
}

/* 底部悬浮汇总栏 */
.summary-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
}

.summary-main {
  display: flex;
  flex: 1;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.summary-item.highlight .summary-num {
  color: #10ac84;
}

.summary-label {
  font-size: 20rpx;
  color: #a4b0be;
  margin-top: 4rpx;
}

.summary-toggle {
  font-size: 24rpx;
  color: #576574;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 15;
}

.detail-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 75vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  box-sizing: border-box;
}

.detail-scroll {
  max-height: 55vh;
}

.warn-line {
  color: #e67e22;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.container-block {
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.container-block-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.item-row {
  font-size: 24rpx;
  color: #2c3e50;
  padding: 4rpx 0;
}

.item-row.muted {
  color: #8395a7;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: #f1f2f6;
  color: #2c3e50;
}

.action-btn.primary {
  background: #2c3e50;
  color: #ffffff;
}

.poster-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 600px;
  height: 900px;
}

.poster-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.poster-modal-content {
  position: relative;
  width: 80vw;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.poster-image {
  width: 100%;
  border-radius: 8rpx;
}

.poster-modal-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
