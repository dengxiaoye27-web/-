.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #2c3e50;
}

.radio-group {
  display: flex;
  flex-direction: column;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.custom-inputs {
  margin-top: 12rpx;
  border-top: 1rpx solid #eee;
  padding-top: 12rpx;
}

.input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-row:last-child {
  border-bottom: none;
}

.label {
  color: #576574;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #2c3e50;
}

.info-line {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8395a7;
}

.calc-btn {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin: 8rpx 0 24rpx;
}

.result-line {
  font-size: 28rpx;
  color: #2c3e50;
  padding: 10rpx 0;
}

.result-line.highlight {
  font-size: 36rpx;
  font-weight: 700;
  color: #10ac84;
}

.result-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #a4b0be;
}
